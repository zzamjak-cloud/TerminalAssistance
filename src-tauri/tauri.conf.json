{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Assistance",
  "version": "0.12.4",
  "identifier": "cloud.zzamjak.terminalassistance",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Terminal Assistance",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RDUzQjI2OUIxMjg1Q0UKUldUT2hSS2JKanZWWkZYc3hibjEzdTBiWkVhM2NsT0lDbVNhd0FuYnozVmpyeUJmYWNVZUFqQlIK",
      "endpoints": [
        "https://github.com/zzamjak-cloud/TerminalAssistance/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
